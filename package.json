{
  "name": "frikiparty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "biome check .",
    "check:unsafe": "biome check --write --unsafe .",
    "check:write": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "tsx --env-file=.env.prod scripts/migrate-prod.mts",
    "db:push": "drizzle-kit push",
    "db:resync:player-slugs": "tsx --env-file=.env scripts/resync-player-slugs.ts",
    "db:resync:player-slugs:prod": "tsx --env-file=.env.prod scripts/resync-player-slugs.ts",
    "db:backfill:player-slugs": "tsx --env-file=.env scripts/backfill-player-slugs.ts",
    "db:import:historical": "tsx --env-file=.env scripts/import-historical-editions.ts",
    "db:seed:demo": "tsx --env-file=.env scripts/seed-demo-tournaments.ts",
    "db:seed:catalog": "tsx --env-file=.env scripts/seed-catalog.ts",
    "db:seed:catalog:prod": "tsx --env-file=.env.prod scripts/seed-catalog.ts",
    "db:seed:live-test": "tsx --env-file=.env scripts/seed-live-test.ts",
    "db:seed:wiki": "tsx --env-file=.env scripts/seed-wiki.ts",
    "db:seed:wiki:prod": "tsx --env-file=.env.prod scripts/seed-wiki.ts",
    "db:studio": "drizzle-kit studio",
    "audio:sync": "tsx --env-file=.env scripts/sync-audio.ts",
    "wiki:images": "tsx --env-file=.env scripts/sync-wiki-images.ts",
    "dev": "next dev --turbo",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.2",
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "better-auth": "^1.3",
    "drizzle-orm": "^0.41.0",
    "ffmpeg-static": "^5.3.0",
    "next": "^15.2.3",
    "postgres": "^3.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.30.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@11.18.0"
